     2→@lisp
     3→(define (analyze-amb exp)
     4→  (let ((cprocs
     5→         (map analyze (amb-choices exp))))
     6→    (lambda (env succeed fail)
     7→      (define (try-next choices)
     8→        (if (null? choices)
     9→            (fail)
    10→            ((car choices)
    11→             env
    12→             succeed
    13→             (lambda ()
    14→               (try-next (cdr choices))))))
    15→      (try-next cprocs))))
    16→@end lisp
