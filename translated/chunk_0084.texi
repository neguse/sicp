    60
    61	@lisp
    62	(define (reverse sequence)
    63	  (fold-right
    64	   (lambda (x y) ⟨??⟩) nil sequence))
    65
    66	(define (reverse sequence)
    67	  (fold-left
    68	   (lambda (x y) ⟨??⟩) nil sequence))
