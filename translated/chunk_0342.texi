          (reg exp))
  (save unev)   @r{; 後で使うために変数を保存}
  (assign exp
          (op assignment-value)
          (reg exp))
  (save env)
  (save continue)
  (assign continue
          (label ev-assignment-1))
  @r{; 代入値を評価:}
  (goto (label eval-dispatch))
ev-assignment-1
  (restore continue)
  (restore env)
  (restore unev)
  (perform (op set-variable-value!)
           (reg unev)
           (reg val)
           (reg env))
  (assign val
          (const ok))
  (goto (reg continue))
@end lisp

@noindent
定義も同様の方法で処理されます。

@lisp
ev-definition
  (assign unev
          (op definition-variable)
          (reg exp))
  (save unev)   @r{; 後で使うために変数を保存}
  (assign exp
          (op definition-value)
          (reg exp))
  (save env)
  (save continue)
  (assign continue (label ev-definition-1))
  @r{; 定義値を評価:}
  (goto (label eval-dispatch))
ev-definition-1
  (restore continue)
  (restore env)
  (restore unev)
  (perform (op define-variable!)
           (reg unev)
           (reg val)
           (reg env))
  (assign val (const ok))
  (goto (reg continue))
@end lisp

