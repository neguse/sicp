(define (segments agenda) (cdr agenda))
(define (set-segments! agenda segments)
  (set-cdr! agenda segments))
(define (first-segment agenda)
  (car (segments agenda)))
(define (rest-segments agenda)
  (cdr (segments agenda)))
@end lisp

@noindent
アジェンダは、タイムセグメントがない場合に空です:

@lisp
(define (empty-agenda? agenda)
  (null? (segments agenda)))
@end lisp

@noindent
アジェンダにアクションを追加するには、まずアジェンダが空かどうかをチェックします。空の場合、アクションのためのタイムセグメントを作成し、これをアジェンダにインストールします。そうでない場合、アジェンダをスキャンし、各セグメントの時刻を調べます。予定された時刻のセグメントが見つかった場合、関連するキューにアクションを追加します。予定された時刻より後の時刻に達した場合、その直前にアジェンダに新しいタイムセグメントを挿入します。アジェンダの終わりに達した場合、最後に新しいタイムセグメントを作成する必要があります。

@lisp
(define (add-to-agenda! time action agenda)
  (define (belongs-before? segments)
    (or (null? segments)
        (< time
           (segment-time (car segments)))))
  (define (make-new-time-segment time action)
    (let ((q (make-queue)))
      (insert-queue! q action)
      (make-time-segment time q)))
  (define (add-to-segments! segments)
    (if (= (segment-time (car segments)) time)
        (insert-queue!
         (segment-queue (car segments))
         action)
        (let ((rest (cdr segments)))
          (if (belongs-before? rest)
              (set-cdr!
               segments
               (cons (make-new-time-segment
                      time
                      action)
                     (cdr segments)))
              (add-to-segments! rest)))))
  (let ((segments (segments agenda)))
    (if (belongs-before? segments)
        (set-segments!
         agenda
         (cons (make-new-time-segment
                time
                action)
               segments))
        (add-to-segments! segments))))
@end lisp

@noindent
アジェンダから最初の項目を削除する手続きは、最初のタイムセグメントのキューの先頭にある項目を削除します。この削除によってタイムセグメントが空になった場合、セグメントのリストからそれを削除します:@footnote{この手続きの @code{if} 式には @code{⟨}@var{alternative}@code{⟩} 式がないことに注意してください。このような「片腕の @code{if} 文」は、2 つの式の間で選択するのではなく、何かを実行するかどうかを決定するために使用されます。述語が偽で @code{⟨}@var{alternative}@code{⟩} がない場合、@code{if} 式は未指定の値を返します。}

@lisp
(define (remove-first-agenda-item! agenda)
  (let ((q (segment-queue
            (first-segment agenda))))
    (delete-queue! q)
    (if (empty-queue? q)
        (set-segments!
         agenda
         (rest-segments agenda)))))
@end lisp

@noindent
最初のアジェンダ項目は、最初のタイムセグメントのキューの先頭にあります。項目を抽出するたびに、現在時刻も更新します:@footnote{このようにして、現在時刻は常に最も最近処理されたアクションの時刻になります。この時刻をアジェンダの先頭に格納することで、関連するタイムセグメントが削除されても、それがまだ利用可能であることを保証します。}

@lisp
(define (first-agenda-item agenda)
  (if (empty-agenda? agenda)
      (error "Agenda is empty:
              FIRST-AGENDA-ITEM")
      (let ((first-seg
             (first-segment agenda)))
        (set-current-time!
         agenda
         (segment-time first-seg))
